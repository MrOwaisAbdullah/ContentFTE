# Copy this file to .env for local development (already gitignored -- never
# commit a real .env). Full explanation of every service and where to get
# each credential: docs/service_setup.md.
#
# This file covers local dev only. In production:
#   - The pipeline (scripts/run_stage.py) runs via GitHub Actions
#     (.github/workflows/pipeline.yml) using GitHub *repo secrets*, not this
#     file -- set the same variable names there under Settings -> Secrets and
#     variables -> Actions.
#   - The Discord bot (discord_bot/bot.py) runs on the VPS via Dokploy using
#     variables set in Dokploy's own env panel, not this file.

# --- This app's own auth (protects the FastAPI endpoints in main.py, which
# are no longer the active trigger path but are left in the repo) ---
API_KEY=your_custom_api_key

# --- Google Sheets (pipeline's database) ---
# Entire contents of your Google service account JSON key, as one line.
# See docs/service_setup.md section 2 for the required spreadsheets/worksheets.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# --- LLM providers (used by the custom fallback runner) ---
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# --- Jev System One (TypeSafe) â€” optional, defaults shown ---
# Reuses OPENROUTER_API_KEY via Decisions API (https://openrouter.ai/api/alpha/decisions);
# no new key needed. Pin model once thresholds are tuned; alias ~typesafe/jev-latest tracks newest.
# 1.14 probe (2026-10-15): text decisions work over this route; image `assets` are silently
# dropped here -- native images need TypeSafe's direct API + a TYPESAFE_API_KEY.
# See lib/jev.py + discord_bot/jev_helper.py (Phase 0 plumbing, httpx/requests) and
# .claude/skills/jev-system-one/ references for alternatives (TypeSafe SDK with base_url override).
JEV_MODEL=typesafe/jev-1.14
# JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# 5000ms: live first call ~4.1s, batched 1.2-2.0s; 1500ms was too low
JEV_TIMEOUT_MS=5000

# --- Research / search ---
TAVILY_API_KEY=your_tavily_api_key
SERPAPI_KEY=your_serpapi_key

# --- Images ---
PEXELS_API_KEY=your_pexels_api_key
# Primary AI image generator (Cloudflare Workers AI, FLUX.2 [dev]) --
# 10,000 free Neurons/day, no credit card required. Freepik was removed
# (persistent 401 from an expired key, and only a one-time trial credit to
# begin with, not an ongoing free tier).
# Account ID: Cloudflare dashboard sidebar. API token: My Profile > API
# Tokens > Create Token > "Workers AI" template (needs Account.Workers AI:Edit).
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token
# Image model routing (defaults shown). Attempt 1 uses the cheap textless
# model; QA failure escalates to the text-capable model with a headline.
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# IMAGE_TEXT_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# IMAGE_ROUTER=1
# IMAGE_MAX_REVISIONS=3
# In-post stock-first gate (spec 5.9): a Pexels candidate must score >= this
# VLM+Jev topic-relevancy (0-1) to be used for free; below it an on-brand AI
# image is generated instead. Featured images are always AI-generated.
IMAGE_STOCK_RELEVANCY_THRESHOLD=0.90
# Fallback USD cost logged for an unmeasured image model id (image_logs).
# IMAGE_COST_DEFAULT_USD=0.0012

# --- Sanity CMS ---
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_write_token
SANITY_DEFAULT_AUTHOR_ID=your_author_document_id
SANITY_DEFAULT_AUTHOR_NAME="Your Author Name"

# --- Discord bot (discord_bot/bot.py) ---
# Only needed if you're running the bot locally for testing; in production
# these live in Dokploy's env panel, not here.
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APPROVAL_CHANNEL_ID=123456789012345678
GITHUB_PAT=your_fine_grained_github_pat_with_actions_write
GITHUB_REPO=your-github-username/ContentFTE

# --- Pipeline -> Discord notification ---
# Incoming webhook URL for the approval channel; scripts/run_stage.py posts
# draft-ready-for-review messages here after the "content" stage.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# --- ContentFTE Phase 1: Postgres + SEO data + WordPress + SDK ---
# Neon Postgres. Unset = local sqlite ./contentfte.db (dev/test).
# Switch = create the database, run scripts/copy_sqlite_to_postgres.py to
# move the local sqlite rows over (ids preserved, re-runnable), set this URL,
# restart. Runbook: docs/postgres-cutover.md
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.neon.tech/contentfte?sslmode=require
# SEO data provider: off (manual, zero cost) | openseo | dataforseo
SEO_DATA_PROVIDER=off
# GSC decay job (scripts/decay_job.py, scheduled monthly): >30% click decay
# over 90 days auto-generates a refresh brief for the operator to review.
# DECAY_THRESHOLD=0.30
# DECAY_WINDOW_DAYS=90
#
# How a decaying page is refreshed (REFRESH_POLICY):
#   escalate  (default, current behaviour) a page whose clicks fell by >= MAJOR_REFRESH_THRESHOLD
#             (below) OR that is older than REFRESH_STALE_DAYS gets a MAJOR refresh: the article is
#             republished under a NEW URL and the old one is 301-redirected. That resets the page's
#             URL history, and a click drop is not always lost rank (AI Overviews can take the click
#             while the page still ranks), so it can destroy a page that was merely out of date.
#   in_place  RECOMMENDED. Every decaying page is refreshed in place: same URL, rewritten and
#             re-dated (dateModified moves only for a substantive edit). A new URL + 301 is then used
#             only for an intent shift or a big quality gap, which are structural problems.
# REFRESH_POLICY=escalate
# MAJOR_REFRESH_THRESHOLD=0.50   # only used by `escalate`: decay at/above this => new URL + 301
# REFRESH_STALE_DAYS=365         # only used by `escalate`: pages older than this => new URL + 301
# Ignore pages whose PRIOR window had fewer clicks than this (3 -> 2 clicks is "33% decay" of noise).
# DECAY_MIN_PRIOR_CLICKS=10
# OPENSEO_API_BASE=https://api.openseo.so/v1
# OPENSEO_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_SANDBOX=1
# Writer/critic model selection â€” WIRED LAST with the model-router refactor.
# WRITER_MODEL=deepseek/deepseek-v4.1-flash
# CRITIC_MODEL=
# WordPress REST (Application Passwords) â€” Phase 1B
# WP_BASE_URL=https://example.com
# WP_USERNAME=
# WP_APP_PASSWORD=
# WP render target for build_prepared_post/publish: blocks (Gutenberg block
# markup, default) | elementor (plain-HTML body + Elementor document written
# over REST meta, Elementor >= 3.27; fails open â€” the post still exists as a
# standard post if the Elementor write fails).
# WP_RENDER_TARGET=blocks
# Custom-site (Astro/Next/React) push delivery â€” the site's build hook / API
# route. Unset = use the SDK pull route (GET /sdk/v1/articles/{id}/content).
# SITE_PUBLISH_WEBHOOK=
# --- ContentFTE Phase 1: generation quality gates + cost ledger ---
# Revise loop: after a draft fails the deterministic checks (word floor,
# TL;DR, Sources, FAQs, stale year, links), one bounded re-generation runs
# with the failing checks fed back. Set 0 to keep single-shot generation.
# CONTENTFTE_REVISE=1
# Hard word floor checked by generate_content (aim 1500-2500 in the prompt).
# GEN_MIN_WORDS=900
# Where staged featured/in-post images are copied so publish/refresh can
# re-upload them later (default: <system temp>/contentfte_images). On a
# server point this at a persistent volume — the OS temp dir is cleared on
# reboot and publish/refresh re-upload from these files.
# IMAGE_STAGING_DIR=
# Image-provider quota circuit breaker cooldown (seconds) after a 429 /
# quota error â€” all AI image generation is skipped meanwhile (stock is not).
# IMAGE_QUOTA_COOLDOWN_S=3600
# LLM pricing for the per-post cost ledger (USD per 1M tokens). Unset =
# mid-tier estimate; matching is substring-based on the reported model ids.
# LLM_PRICE_INPUT_PER_M=0.10
# LLM_PRICE_OUTPUT_PER_M=0.40
# SDK server auth. The REST API (/sdk/v1) AND the MCP endpoint (/mcp) both require
# this key (header `X-Site-Key: <key>` or `Authorization: Bearer <key>`). When it is
# unset the engine FAILS CLOSED (503) rather than serving everyone. Use the same value
# as the console instance's apiKey / ENGINE_API_KEY.
# SDK_MASTER_KEY=
# SDK_MASTER_KEY is the PLATFORM key: it can reach every site and the platform-wide routes. Do NOT hand it
# to a client or embed it in a website. For those, mint a per-site key (it only ever sees ONE site, with
# only the scopes you choose, and can be revoked on its own):
#   curl -X POST $ENGINE/sdk/v1/sites/<slug>/keys -H "X-Site-Key: $SDK_MASTER_KEY" \
#        -H 'Content-Type: application/json' -d '{"label":"marketing site","scopes":["read"]}'
# (or use the "Site API keys" card on the site page in the console). The `key` in the response is shown once.
# Scopes: read | write | approve | publish | admin  (admin implies all; anything implies read). Default: read.
# Local development ONLY: serve requests without a key. Never set this on a host that
# anyone else can reach.
# SDK_ALLOW_UNAUTHENTICATED=1

# Quality gate at approval (lib/quality_gate.py). When an article is approved the engine checks
# it deterministically: the draft checks recorded at generation (word floor, TL;DR, Sources...),
# numeric/date claims against the research stored for the article, the eval sub-score floor
# (when the six sub-scores were recorded) and, optionally, broken links. A failure REFUSES the
# approval (REST 409 with the reasons) unless the approver overrides it with force=true; the
# override and the reasons it bypassed are written to the audit log.
#   on  / unset  ENFORCE (the engine's default): a failing article cannot be approved without an
#                explicit, audited override.
#   off          REPORT-ONLY: the gate still runs, is shown in the console and recorded in the
#                audit log, but never refuses. Use this while you calibrate the gate on real
#                drafts, then remove the line (or set it to `on`) to start enforcing.
QUALITY_GATE_ENFORCE=off
# Also HEAD every external link when assessing (slower, needs outbound network). Broken links
# block; links on sites that block bots (403/429) only warn. Off by default; WordPress publish
# already validates links.
# QUALITY_GATE_CHECK_LINKS=1
# Require the evaluator's six sub-scores on every ENGINE-GENERATED article before it can be approved, so a draft
# that skipped the evaluator cannot pass on the cheap Jev classifier alone. Off by default.
# QUALITY_GATE_REQUIRE_EVAL=0
# Approving an article with an EMPTY body is a warning; set to 1 to make it a hard stop. (Publishing an empty
# article is always refused unless PUBLISH_REQUIRE_CONTENT=0, which exists for test fixtures.)
# QUALITY_GATE_REQUIRE_CONTENT=0
# Decay job: also compare each window with the same one a year earlier and skip drops that repeat (seasonality).
# Doubles the Search Console queries per page.
# DECAY_USE_YOY=0
# PUBLISH_REQUIRE_CONTENT=1
# Per-run limits for the agent pipeline (0 = unlimited): model attempts and wall-clock seconds.
# RUN_MAX_MODEL_CALLS=300
# RUN_MAX_SECONDS=1500
# Internal-link lookups per run window (one per H2) and the window length in seconds.
# INTERNAL_LINKS_MAX_CALLS=6
# INTERNAL_LINKS_WINDOW_S=1800
# A secondary keyword that appears fewer than twice is REPORTED (guidance shown, revise loop not forced) but no
# longer blocks the draft: Google says there is no need to rewrite a page for every phrasing of a query, and a
# hard minimum pushes drafts toward stuffing. Set to `on` to restore the hard gate.
# KEYWORD_GATE_ENFORCE=off
# The evaluator's own `overall` score is capped at (mean of its six sub-scores + this many points), so a
# draft with 82s across the board cannot be reported as 94 and pass the >=90 gate. 0 = overall IS the mean.
# EVAL_OVERALL_TOLERANCE=5
# REST/MCP article submission no longer invents a site from an unknown slug (a typo created a phantom
# tenant). Only the instance's DEFAULT_SITE_SLUG is auto-created; set this to 1 to restore create-on-submit.
# SDK_AUTO_CREATE_SITES=0
# Tags derived from the keyword when the brief supplies none (each tag is an archive page; many one-post
# archives are thin content). Brief-supplied tags are unaffected. 0 = derive none.
# DERIVED_TAGS_MAX=3
# SQLite only: WAL journal (readers and the writer overlap). Off by default because deleting just the .db file
# during a dev reset leaves a stale -wal file behind. A 30s busy timeout is always on.
# SQLITE_WAL=0
# log_coverage writes approved-post records to the database; by default it ALSO commits them to brain/ in git.
# Set to 0 for DB-only (no commit, no push) - right when one git repo cannot belong to every site.
# LOG_COVERAGE_GIT=1
# --- Secrets at rest ---
# Encrypts the WordPress app password, IndexNow/Bing keys, Discord webhook and delivery secret stored in the
# database (Fernet). Several keys, comma separated, = rotation: the first encrypts, all can decrypt.
# Generate one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it OUTSIDE the database (env / secret manager). Then run:  python scripts/encrypt_site_secrets.py
# SECRETS_KEY=
# Error tracking (optional; needs `uv sync --extra monitoring`). Events are scrubbed before they leave the process.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# See docs/operations-runbook.md for backups, alerts, the uptime probe and migrations.
# LanguageTool: point at an already-running server instead of starting a local JVM (grammar_check_tool).
# LANGUAGETOOL_REMOTE_SERVER=
# Model-chosen URL guard for Tavily extract/crawl and title fetches (set off only to debug):
# URL_GUARD=on
# Sanity: SANITY_PUBLISH_AS_DRAFT=1 writes posts as drafts for review; SANITY_REQUIRE_IMAGE=1 holds image-less posts as drafts.
# SANITY_PUBLISH_AS_DRAFT=0
# SANITY_REQUIRE_IMAGE=0
# Custom-site delivery: SITE_PUBLISH_WEBHOOK (url) + SITE_PUBLISH_SECRET (HMAC key) for a single-site instance;
# multi-site instances set Site.settings.delivery.{webhook_url,secret} per site instead.
# SITE_PUBLISH_WEBHOOK=
# SITE_PUBLISH_SECRET=
# --- Engine observability / exposure ---
# Every response carries X-Request-ID (yours, if you send a sane one) and every log line written while handling
# it carries the same id. LOG_FORMAT=json writes one JSON object per line for a log shipper.
# LOG_FORMAT=text
# LOG_LEVEL=INFO
# /docs, /redoc and /openapi.json list every route to anyone who can reach the engine, so they are OFF unless:
# ENGINE_DOCS=0
# In shared (multi-tenant) mode SDK_CORS_ORIGINS defaults to NO cross-origin access (single-site: *). Set the
# allowed browser origins explicitly, comma-separated:
# SDK_CORS_ORIGINS=https://yoursite.com
# CORS origins for browser SDK use (React/Next/Astro). Default: * (safe â€”
# auth is header-based, never cookies). Comma-separated to restrict.
# SDK_CORS_ORIGINS=*
# IndexNow + Bing Webmaster (Phase 1A publish pipeline, Â§5.6) â€” wired in
# lib/indexing.py, called from service.publish_article / refresh_article
# (fail-open: a ping failure never fails a publish). INDEXNOW_KEY = hex
# 8-128 chars, hosted by YOU as {key}.txt at the site root (one-time setup).
# BING_WMT_API_KEY = Bing Webmaster Tools -> Settings -> API access.
# Setting either key enables its path; INDEXING_ENABLED=0 suppresses both.
# INDEXNOW_KEY=
# BING_WMT_API_KEY=
# INDEXING_ENABLED=1

# --- Defined in the code but not currently wired into any active agent/tool
# -- safe to leave unset unless you're working on the (unimplemented) YouTube
# research feature or the (unused) X/Twitter search tool. See
# docs/service_setup.md's "Quick reference" table for details. ---
# X_API_BEARER_TOKEN=
# RAPID_API_YOUTUBE_TRANSCRIPT_API_KEY=
# YOUTUBE_TRANSCRIPT_IO_API_TOKEN=
# YOUTUBE_TRANSCRIPT_IO_API_TOKEN_2=

# --- Tenancy / instance identity (docs/spec-site2-postgres-frontend.md sec 4b) ---
# isolated (default) = self-contained instance (own DB + own keys).
# shared = platform DB tenant (SaaS shape); requires explicit site_slug --
# lib/store.py refuses the silent default-tenant fallback in this mode.
# TENANCY_MODE=isolated
# Postgres-only instance (no Google Sheets at all): SHEETS_ENABLED=0 makes
# every sheet call fail loudly at tools/sheet_tool.get_gspread_client;
# the pipeline runs via the SDK/service layer (Postgres-native).
# Site #1 keeps the default (1) -- Sheets is its operator queue.
# SHEETS_ENABLED=0
# Site identity overrides (defaults = site #1, owaisabdullah.dev):
# SITE_BASE_URL=https://yourdomain.com
# SEARCH_CONSOLE_SITE_URL=https://yourdomain.com/
# AUTHOR_PROFILE_API_URL=https://yourdomain.com/api/profile
# Discord: one bot token = one gateway process, but it may serve several
# approval channels (comma-separated, one per tenant server). Legacy single
# DISCORD_APPROVAL_CHANNEL_ID still honored (first entry).
# DISCORD_APPROVAL_CHANNEL_IDS=
# Who may use the Discord bot (reactions, slash commands, free-text agent). Comma-separated Discord USER ids.
# Being able to see the approval channel is NOT enough: the bot can approve and edit posts and dispatch the
# pipeline workflow with your GitHub token. If this is unset, only the Discord APPLICATION OWNER (or the
# members of its team) is authorized, so a solo operator needs no configuration. Reactions also only count
# on messages the pipeline posted, never on a message a person typed.
# ALLOWED_DISCORD_USER_IDS=123456789012345678,234567890123456789

# --- gemini-free-router (npm package "gemini-free-router") ---
# Start the local quota router with:  npm run router
# When GFR_BASE_URL is set, blog_agent/custom_runner.py routes EVERY Gemini
# chat call through it (per-model RPM/RPD/TPM windows, queueing, 429 learning,
# failover across its fleet). Leave it unset to call Google directly (legacy).
# GFR_BASE_URL=http://127.0.0.1:8787/v1
# Optional router-side auth (set the same value as GFR_TOKEN when starting the router):
# GFR_TOKEN=
# Router plan: free (default) or pro (scales built-in default limits x4):
# GFR_PLAN=free
# Image VLM (lib/image_vision.py) through the router too. Requires
# gemini-free-router >= 0.3.0 -- earlier versions silently DROP image parts
# (they only translate type="text"), so pointing this at a 0.2.x router makes
# the VLM answer from the prompt alone with no image, which is worse than a
# visible error. Leave unset (direct Google OpenAI-compat endpoint) until
# `npm ls gemini-free-router` shows >= 0.3.0. Verified live 2026-10-14: a
# 1536x1024 data-URI JPEG through the 0.3.0 router returned an accurate
# description (prompt_tokens 1072 actual, replacing the ~1100 estimate).
# IMAGE_VLM_ENDPOINT=http://127.0.0.1:8787/v1/chat/completions
# Judge URL for scripts/compare_results.py. When unset AND GFR_BASE_URL is
# set, the judge follows the router automatically (GFR_BASE_URL +
# /chat/completions) -- routing policy: GFR primary, never Google-native by
# accident. Set explicitly to override; both unset = legacy direct Google.
# JUDGE_URL=http://127.0.0.1:8787/v1/chat/completions
