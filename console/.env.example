# Engine base URL — where `uvicorn main:app` runs (repo root). This is the
# default instance; CONSOLE_INSTANCES overrides the registry entirely.
ENGINE_BASE_URL=http://127.0.0.1:8000
# X-Site-Key value matching the engine's SDK_MASTER_KEY (optional; the
# engine accepts any key when SDK_MASTER_KEY is unset). Server-side only —
# never exposed to the browser.
ENGINE_API_KEY=
# Optional multi-instance registry (JSON array; when set, it replaces the
# ENGINE_* default above). The header switcher sets a console_instance
# cookie naming one of these; every engine call resolves through it.
# CONSOLE_INSTANCES=[{"name":"site1","baseUrl":"http://127.0.0.1:8000","apiKey":""},{"name":"site2","baseUrl":"http://127.0.0.1:8001","apiKey":""}]
# Console operator login (required).
OPERATOR_PASSWORD=change-me
# Session-cookie signing secret (required; any long random string).
SESSION_SECRET=change-me-to-a-long-random-string
